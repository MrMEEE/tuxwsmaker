DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# sqlite (dev) or mariadb (prod)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

REDIS_URL=redis://localhost:6379/0
BUILD_VM_SSH_USER=root
CONCURRENT_BUILDS_DEFAULT=2
CSRF_TRUSTED_ORIGINS=

BUILDER_VM_MEMORY_MIB=2048
BUILDER_VM_VCPUS=1

BUILDER_LIBVIRT_NETWORK=wsbuildnet
BUILDER_LIBVIRT_ENABLE_DHCP=False
BUILDER_LIBVIRT_ENABLE_DNS=False
BUILDER_LIBVIRT_BRIDGE_NAME=virbrwsbld
BUILDER_LIBVIRT_NETWORK_GATEWAY=192.168.200.1
BUILDER_LIBVIRT_NETWORK_NETMASK=255.255.255.0
BUILDER_LIBVIRT_DHCP_START=192.168.200.100
BUILDER_LIBVIRT_DHCP_END=192.168.200.254
BUILDER_VM_STATIC_IPV4=192.168.200.10
BUILDER_VM_STATIC_PREFIX=24
BUILDER_VM_NIC_MAC=52:54:00:c8:00:0a
# Set this if DHCP is disabled and the builder VM uses a known static IP.
BUILDER_VM_BOOTSTRAP_IP=192.168.200.10
